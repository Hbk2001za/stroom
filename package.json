{
  "name": "stroom",
  "version": "1.1.1",
  "description": "Download YouTube videos, MP3s, and Spotify playlists",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --win",
    "prebuild:mac": "node scripts/fetch-tools.js mac",
    "build:mac": "electron-builder --mac",
    "prebuild:win": "node scripts/fetch-tools.js win",
    "build:win": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.stroom.app",
    "productName": "Stroom",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/logo.icns",
      "extraResources": [
        {
          "from": "build/bin/mac/yt-dlp",
          "to": "bin/yt-dlp"
        },
        {
          "from": "build/bin/mac/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "build/bin/mac/spotdl",
          "to": "bin/spotdl"
        }
      ],
      "x64ArchFiles": "Contents/Resources/bin/**"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 60,
          "type": "file",
          "path": "build/Read Me First.txt"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/logo.ico",
      "extraResources": [
        {
          "from": "build/Windows Read Me First.txt",
          "to": "Windows Read Me First.txt"
        },
        {
          "from": "build/bin/win/yt-dlp.exe",
          "to": "bin/yt-dlp.exe"
        },
        {
          "from": "build/bin/win/ffmpeg.exe",
          "to": "bin/ffmpeg.exe"
        },
        {
          "from": "build/bin/win/spotdl.exe",
          "to": "bin/spotdl.exe"
        },
        {
          "from": "build/bin/win/demucs.exe",
          "to": "bin/demucs.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "build/logo.icns",
      "build/logo.ico"
    ]
  }
}